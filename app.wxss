page {
  min-height: 100vh;
  color: #17201d;
  background: #f4f7f6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #dce8e4;
  border-radius: 8rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f2f2a;
}

.muted {
  color: #6a7773;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.input,
.textarea {
  width: 100%;
  min-height: 76rpx;
  padding: 16rpx 18rpx;
  color: #17201d;
  background: #f8fbfa;
  border: 1rpx solid #c9d9d4;
  border-radius: 8rpx;
}

.textarea {
  min-height: 120rpx;
}

.label {
  margin-bottom: 8rpx;
  color: #50605b;
  font-size: 24rpx;
}

.btn {
  height: 80rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.btn-primary {
  color: #ffffff;
  background: #0f766e;
}

.btn-secondary {
  color: #0f4f49;
  background: #e4f3ef;
}

.btn-danger {
  color: #ffffff;
  background: #b42318;
}

.btn-plain {
  color: #0f766e;
  background: #ffffff;
  border: 1rpx solid #b7d7d0;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  color: #0f4f49;
  background: #e4f3ef;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.badge-warn {
  color: #8a4b00;
  background: #fff1cf;
}

.badge-error {
  color: #9f1a12;
  background: #ffe1de;
}

.badge-ok {
  color: #166534;
  background: #dcfce7;
}

.empty {
  padding: 48rpx 24rpx;
  color: #6a7773;
  text-align: center;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

@media (max-width: 360px) {
  .grid-2 {
    grid-template-columns: 1fr;
  }
}
