.action-row {
  margin-top: 22rpx;
}

.error-box {
  margin-top: 18rpx;
  padding: 18rpx;
  color: #9f1a12;
  background: #ffecea;
  border: 1rpx solid #ffc7c2;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.lock-box {
  margin-top: 18rpx;
  padding: 18rpx;
  color: #166534;
  background: #dcfce7;
  border: 1rpx solid #bbf7d0;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.preview-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.compare-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.compare-subtitle {
  margin-bottom: 12rpx;
  color: #50605b;
  font-size: 24rpx;
  font-weight: 700;
}

.key-image-panel,
.items-panel {
  min-width: 0;
}

.key-image {
  width: 100%;
  min-height: 320rpx;
  background: #dfe8e5;
  border: 1rpx solid #dce8e4;
  border-radius: 8rpx;
}

.key-empty {
  min-height: 180rpx;
}

.full-image-btn {
  margin-top: 14rpx;
}

.preview-card {
  padding: 18rpx;
  background: #f8fbfa;
  border: 1rpx solid #dce8e4;
  border-radius: 8rpx;
}

.preview-head {
  margin-bottom: 14rpx;
}

.preview-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #0f2f2a;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-amount {
  color: #b42318;
  font-size: 30rpx;
  font-weight: 700;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preview-label {
  display: block;
  color: #6a7773;
  font-size: 22rpx;
}

.preview-value {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #17201d;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notes-field {
  margin-top: 16rpx;
}

.small-btn {
  width: 156rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
}

.item-card {
  margin-top: 18rpx;
  padding: 20rpx;
  background: #f8fbfa;
  border: 1rpx solid #dce8e4;
  border-radius: 8rpx;
}

.item-title {
  margin-bottom: 16rpx;
  font-weight: 700;
}

.remove-line {
  width: 112rpx;
  height: 56rpx;
  padding: 0;
  color: #b42318;
  background: #fff;
  border: 1rpx solid #ffc7c2;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.bottom-actions {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 -28rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(244, 247, 246, 0.96);
  border-top: 1rpx solid #dce8e4;
}
