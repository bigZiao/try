<view class="page">
  <view class="section">
    <view class="section-title">手工录入账单</view>
    <view class="grid-2">
      <view>
        <view class="label">商家</view>
        <input class="input" value="{{form.supplier}}" data-field="supplier" bindinput="onHeaderInput" />
      </view>
      <view>
        <view class="label">日期</view>
        <input class="input" placeholder="2024-04-09" value="{{form.receipt_date}}" data-field="receipt_date" bindinput="onHeaderInput" />
      </view>
      <view>
        <view class="label">总数量</view>
        <input class="input" type="number" value="{{form.total_quantity}}" data-field="total_quantity" bindinput="onHeaderInput" />
      </view>
      <view>
        <view class="label">总金额</view>
        <input class="input" type="digit" value="{{form.total_amount}}" data-field="total_amount" bindinput="onHeaderInput" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="row-between">
      <view class="section-title">商品明细</view>
      <button class="btn btn-plain small-btn" bindtap="addItem">新增行</button>
    </view>
    <view wx:for="{{form.items}}" wx:key="index" class="item-card">
      <view class="row-between item-title">
        <text>第 {{index + 1}} 行</text>
        <button class="remove-line" bindtap="removeItem" data-index="{{index}}" disabled="{{form.items.length <= 1}}">删除</button>
      </view>
      <view class="grid-2">
        <view>
          <view class="label">款号</view>
          <input class="input" value="{{item.style_no}}" data-index="{{index}}" data-field="style_no" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">商品名</view>
          <input class="input" value="{{item.product_name}}" data-index="{{index}}" data-field="product_name" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">颜色</view>
          <input class="input" value="{{item.color}}" data-index="{{index}}" data-field="color" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">尺码</view>
          <input class="input" value="{{item.size}}" data-index="{{index}}" data-field="size" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">数量</view>
          <input class="input" type="number" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">单价</view>
          <input class="input" type="digit" value="{{item.unit_price}}" data-index="{{index}}" data-field="unit_price" bindinput="onItemInput" />
        </view>
        <view>
          <view class="label">小计</view>
          <input class="input" type="digit" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="onItemInput" />
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-actions single-action">
    <button class="btn btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存并审核</button>
  </view>
</view>
