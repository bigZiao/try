<view class="page">
  <view class="section user-section">
    <view class="row-between">
      <view>
        <view class="muted">当前老板</view>
        <view class="user-title">用户ID：{{userId}}<text wx:if="{{userName}}"> / {{userName}}</text></view>
      </view>
      <button class="btn btn-plain small-login" loading="{{loadingReceipts}}" bindtap="loadRecentReceipts">刷新</button>
    </view>
  </view>

  <view class="upload-hero" bindtap="uploadReceiptImages">
    <view class="upload-title">上传拿货账单</view>
    <view class="upload-subtitle">拍照或选择图片，自动识别</view>
    <button class="btn btn-primary upload-button" loading="{{uploading}}" disabled="{{uploading}}">开始上传</button>
  </view>

  <view class="section">
    <view class="row-between">
      <view>
        <view class="section-title">全部账单</view>
        <view class="muted">最近 20 张账单</view>
      </view>
      <view class="row">
        <button class="btn btn-primary small-export" loading="{{exportingSelected}}" bindtap="exportSelectedReceipts">导出</button>
        <button class="btn btn-plain small-login" bindtap="openReceiptsPage">更多</button>
      </view>
    </view>
    <view class="muted selected-note">已选 {{selectedReceiptIds.length}} 张。点击左侧圆点选择导出。</view>

    <view wx:if="{{!receipts.length}}" class="empty">暂无账单。</view>
    <view wx:else class="simple-list">
      <view wx:for="{{receipts}}" wx:key="id" class="simple-card">
        <view class="row-between">
          <view class="select-dot {{item.selected ? 'select-dot-on' : ''}}" data-id="{{item.id}}" catchtap="toggleReceiptSelect">{{item.selected ? '✓' : ''}}</view>
          <view class="supplier" data-id="{{item.id}}" bindtap="openReceipt">{{item.supplierText}}</view>
          <text class="badge badge-{{item.tone}}">{{item.statusText}}</text>
        </view>
        <view class="receipt-line">
          <text>{{item.descText}}</text>
          <text>总数 {{item.total_quantity || 0}}</text>
          <text>总金额 {{item.total_amount || 0}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
