.user-section {
  margin-bottom: 18rpx;
}

.user-title {
  margin-top: 6rpx;
  color: #0f2f2a;
  font-size: 32rpx;
  font-weight: 700;
}

.small-login {
  width: 132rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
}

.small-export {
  width: 132rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
}

.small-export-select {
  width: 168rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
}

.small-cancel {
  width: 112rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
}

.selected-note {
  margin: 12rpx 0 18rpx;
}

.upload-hero {
  margin-bottom: 24rpx;
  padding: 44rpx 32rpx;
  color: #ffffff;
  background: #0f766e;
  border-radius: 8rpx;
}

.upload-title {
  font-size: 42rpx;
  font-weight: 800;
}

.upload-subtitle {
  margin-top: 10rpx;
  color: #d7f4ee;
  font-size: 26rpx;
}

.upload-button {
  margin-top: 30rpx;
  color: #0f4f49;
  background: #ffffff;
}

.simple-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.simple-card {
  padding: 20rpx;
  background: #f8fbfa;
  border: 1rpx solid #dce8e4;
  border-radius: 8rpx;
}

.supplier {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #17201d;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-dot {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  color: #ffffff;
  background: #ffffff;
  border: 2rpx solid #9fb8b1;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.select-dot-on {
  background: #0f766e;
  border-color: #0f766e;
}

.receipt-line {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 18rpx;
  margin-top: 14rpx;
  color: #50605b;
  font-size: 24rpx;
}
