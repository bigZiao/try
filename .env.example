DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=uploads

# mock | baidu
OCR_PROVIDER=mock
OCR_MOCK_JSON_PATH=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic

# mock | http | deepseek
LLM_PROVIDER=mock
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# mock | text_fallback | openai_compatible | doubao | ark | volcengine
VISION_LLM_PROVIDER=mock
VISION_LLM_API_KEY=
VISION_LLM_MODEL=doubao-1-5-vision-pro-32k-250115
VISION_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional aliases used by Volcengine Ark/Doubao
ARK_API_KEY=
DOUBAO_API_KEY=

# In-process MVP concurrency limits. Use a real worker queue for production.
BATCH_PROCESSING_CONCURRENCY=3
OCR_CONCURRENCY=5
LLM_CONCURRENCY=2
VISION_LLM_CONCURRENCY=1
