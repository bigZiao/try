DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=uploads

# OCR/vision image preprocessing. Original uploads are always preserved.
OCR_IMAGE_PREPROCESS_ENABLED=true
OCR_IMAGE_DIR=uploads/ocr_images
CROP_IMAGE_DIR=uploads/crops
OCR_IMAGE_MAX_SIDE=2400
OCR_IMAGE_JPEG_QUALITY=92
OCR_IMAGE_MAX_BYTES=4000000

# mock | baidu
OCR_PROVIDER=mock
OCR_MOCK_JSON_PATH=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic

# mock | http | deepseek
LLM_PROVIDER=mock
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# mock | text_fallback | openai_compatible | doubao | ark | volcengine
VISION_LLM_PROVIDER=mock
VISION_LLM_API_KEY=
VISION_LLM_MODEL=doubao-1-5-vision-pro-32k-250115
VISION_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional aliases used by Volcengine Ark/Doubao
ARK_API_KEY=
DOUBAO_API_KEY=

# In-process MVP concurrency limits. Use a real worker queue for production.
BATCH_PROCESSING_CONCURRENCY=3
OCR_CONCURRENCY=5
LLM_CONCURRENCY=2
VISION_LLM_CONCURRENCY=1

# Receipt task queue controls. Current MVP uses DB-backed tasks + in-process workers.
RECEIPT_TASK_MAX_ATTEMPTS=3
RECEIPT_TASK_STALE_MINUTES=30

# Mini-program login / admin
WECHAT_LOGIN_PROVIDER=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_TOKEN=
LLM_PROMPT_TOKEN_PRICE_PER_MILLION=0
LLM_COMPLETION_TOKEN_PRICE_PER_MILLION=0
